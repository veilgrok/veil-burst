diff --git a/Linux-DSM-4.18/arch/x86/kvm/ktcp.c b/Linux-DSM-4.18/arch/x86/kvm/ktcp.c
index cb08e1399..070c8fc76 100644
--- a/Linux-DSM-4.18/arch/x86/kvm/ktcp.c
+++ b/Linux-DSM-4.18/arch/x86/kvm/ktcp.c
@@ -199,7 +199,8 @@ read_again:
 	ret = kernel_recvmsg(sock, &msg, &vec, 1, expected_size - len, flags | MSG_DONTWAIT);
 
 	if (ret == 0) {
-		return len;
+		/* peer closed: a partial message is an error, not a message */
+		return len ? -ECONNRESET : len;
 	}
 
 	// Non-blocking on the first try
@@ -209,6 +210,12 @@ read_again:
 	}
 
 	if (ret == -EAGAIN || ret == -ERESTARTSYS) {
+		/* mid-message: yield instead of spinning with rlock held, so the
+		 * rest of the segments (and softirq RX) can make progress */
+		if (len > 0)
+			usleep_range(5, 20);
+		else
+			cond_resched();
 		goto read_again;
 	}
 	else if (ret < 0) {
@@ -217,7 +224,7 @@ read_again:
 	}
 	len += ret;
 	if (len != expected_size) {
-		printk(KERN_WARNING "ktcp_receive receive %d bytes which expected_size=%lu bytes, read again", len, expected_size);
+		if (printk_ratelimit()) printk(KERN_WARNING "ktcp_receive receive %d bytes which expected_size=%lu bytes, read again", len, expected_size);
 		goto read_again;
 	}
 
